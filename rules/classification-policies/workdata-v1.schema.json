{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://file-agent.local/schemas/classification-policy-v1.json",
  "title": "File Agent workdata 分类规则",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "policy_mode", "candidate_limit", "resume_window_paragraphs", "resume_window_characters", "rules"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "policy_mode": {"const": "conservative_rules"},
    "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 8},
    "resume_window_paragraphs": {"type": "integer", "minimum": 1, "maximum": 12},
    "resume_window_characters": {"type": "integer", "minimum": 200, "maximum": 3000},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "signalGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_groups", "any_group", "same_section"],
      "properties": {
        "all_groups": {"type": "array", "items": {"type": "array", "items": {"type": "string", "minLength": 1}}},
        "any_group": {"type": "array", "items": {"type": "array", "items": {"type": "string", "minLength": 1}}},
        "same_section": {"type": "array", "items": {"type": "array", "items": {"type": "string", "minLength": 1}}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version", "candidate_category_ids", "subject_signals", "action_signals", "title_signals", "negative_contexts", "scope_policy", "evidence_requirements", "regression_sample_ids"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
        "version": {"type": "string", "minLength": 1},
        "candidate_category_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subject_signals": {"$ref": "#/$defs/signalGroups"},
        "action_signals": {"$ref": "#/$defs/signalGroups"},
        "title_signals": {"$ref": "#/$defs/signalGroups"},
        "negative_contexts": {"type": "array", "items": {"type": "string"}},
        "scope_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred_roots", "required"],
          "properties": {
            "preferred_roots": {"type": "array", "items": {"enum": ["学校", "学院"]}},
            "required": {"type": "boolean"}
          }
        },
        "evidence_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_groups", "require_body_signal"],
          "properties": {
            "minimum_groups": {"type": "integer", "minimum": 1, "maximum": 8},
            "require_body_signal": {"type": "boolean"}
          }
        },
        "regression_sample_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
