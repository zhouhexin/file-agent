# 复制为 .env 后填写真实密码；.env 不应提交到 Git。
DATABASE_URL=postgresql+psycopg2://fileagent_user:<password>@212.64.14.158:5432/fileAgent
AUTO_CREATE_TABLES=false
FILE_STORAGE_ROOT=./storage/uploads
# 上传采用流式写入；上限是部署级资源保护参数，不是业务文件大小规则，可按服务器容量调整。
UPLOAD_MAX_FILE_SIZE_MB=1024
UPLOAD_CHUNK_SIZE_BYTES=1048576
# 只允许 File Agent 当前可受控解析或登记的文件类型，禁止上传可执行脚本。
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,xlsm,txt,md,csv,png,jpg,jpeg,tif,tiff,bmp,webp
# 受管原始目录只读入口由 MANAGED_ROOT_<KEY> 配置；以下独立入口只允许归档 worker 追加文件。
#  是“用户上传文件的原件归档目的地”
MANAGED_ROOT_ARCHIVE_WRITE_PATH=./storage/managed-original/school-files
MANAGED_ROOT_ARCHIVE_ENABLED=true
# 需要同步已有原始目录时，必须另外配置至少一个普通受管根。ARCHIVE_WRITE_PATH
# 是上传归档的受保护写入目的地，故意不会被扫描或导入到工作副本。
# 例：MANAGED_ROOT_SCHOOL_FILES=/absolute/path/to/school-files

# 是“已有原始资料的受管目录”，例如学校历史文件库
MANAGED_ROOT_SCHOOL_FILES=
# 普通用户界面使用业务名称；root_key 只用于安全定位。也兼容旧字段 MANAGED_ROOT_<KEY>_NAME。
MANAGED_ROOT_SCHOOL_FILES_DISPLAY_NAME=学校文件库
MANAGED_ROOT_SCHOOL_FILES_CLASSIFICATION_MODE=NONE
# Agent 的增删改查全部发生在工作副本目录，删除后的内容进入回收站目录。
WORKING_COPY_STORAGE_ROOT=./storage/working-copies
TRASH_STORAGE_ROOT=./storage/trash
MANAGED_ROOT_WATCH_ENABLED=true
# watcher 是独立进程；这里只控制轻量元数据轮询频率，不在回调中复制或解析文件。
MANAGED_ROOT_WATCH_POLL_SECONDS=2
MANAGED_ROOT_RECONCILE_INTERVAL_SECONDS=300
# 启动时只提交同步任务，不在 API 启动钩子里扫描目录或复制文件；运行中的
# 扫描 worker 必须包含 RECONCILE、SCAN、SOURCE_ANALYSIS，按需副本 worker 必须包含 MATERIALIZE。
MANAGED_ROOT_RECONCILE_ON_STARTUP=true
# 大型受管目录采用增量扫描：每达到文件数或时间预算就提交该批源侧分析任务，
# 不会在初始化时复制全部工作副本。这不是上传文件大小限制。
MANAGED_ROOT_SCAN_BATCH_SIZE=100
MANAGED_ROOT_SCAN_BATCH_MAX_SECONDS=5
UPLOAD_ARCHIVE_ENABLED=true
UPLOAD_ARCHIVE_RETRY_INTERVAL_SECONDS=300
# 上传附件先异步查重；发现重复或相似候选后必须通过对话逐文件确认。
UPLOAD_DUPLICATE_CHECK_ENABLED=true
UPLOAD_DUPLICATE_SIMILARITY_THRESHOLD=0.90
UPLOAD_DUPLICATE_MAX_CANDIDATES=5
UPLOAD_DUPLICATE_CONFIRMATION_TTL_HOURS=168
# 查重、归档、导入和同步使用持久化任务；并发与 API 请求并发相互独立。
FILESYSTEM_ASYNC_JOBS_ENABLED=true
FILESYSTEM_JOB_LEASE_SECONDS=120
# FILE_STORAGE_ROOT 等相对路径按进程工作目录解析；API 与 worker 都必须从仓库根目录启动。
# 每个 worker 进程只领取指定队列；生产和 Windows 脚本会拆分 SCAN、IMPORT、ANALYSIS、GRAPH 等队列。
FILESYSTEM_WORKER_QUEUES=DUPLICATE_CHECK,ARCHIVE,IMPORT,ANALYSIS,STRUCTURED_EXTRACTION,RECONCILE,SCAN,SOURCE_ANALYSIS,MATERIALIZE,FILE_OPERATION,GRAPH
FILESYSTEM_WORKER_ID=filesystem-worker-1
FILESYSTEM_WORKER_POLL_SECONDS=3
ARCHIVE_WORKER_CONCURRENCY=2
IMPORT_WORKER_CONCURRENCY=2
WORKING_COPY_IMPORT_BATCH_SIZE=100
WORKING_COPY_OPERATION_BATCH_SIZE=20
TRASH_RETENTION_DAYS=30
# MVP 必须保持 false；永久删除只能由明确确认的 OperationPlan 驱动。
TRASH_AUTO_PURGE_ENABLED=false
# 新受管目录先建立只读源侧检索资料；每个修订分析完成后自动进入低优先级
# 工作副本同步。不同文件可跨队列并行，同一文件必须先分析、后复制。
MANAGED_FILE_INITIALIZATION_MODE=source_index_first
MANAGED_SOURCE_ANALYSIS_ENABLED=true
MANAGED_SOURCE_ANALYSIS_BACKGROUND_PRIORITY=100
MANAGED_SOURCE_ANALYSIS_ON_DEMAND_PRIORITY=10
MANAGED_SOURCE_ANALYSIS_BATCH_SIZE=20
# 旧版 .doc/.xls 的 LibreOffice 转换在 SOURCE_ANALYSIS worker 内限并发，避免抢占 API。
MANAGED_SOURCE_LIBREOFFICE_CONCURRENCY=1
MANAGED_SOURCE_SEARCH_ENABLED=true
# 启动扫描发现的全部文件都会在分析完成后同步；设为 false 仅用于运维降级。
MATERIALIZE_ALL_MANAGED_FILES=true
MATERIALIZE_WORKING_COPY_BACKGROUND_PRIORITY=100
# 最终相关结果在聊天回复提交后提升同一物化任务，不创建并发重复任务。
MATERIALIZE_RELEVANT_FILES_AFTER_RESPONSE=true
MATERIALIZE_WORKING_COPY_PRIORITY=20
MATERIALIZE_RELEVANT_FILES_BATCH_SIZE=50
LOG_DIR=./logs
LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_TIMEOUT_SECONDS=30
# Adaptive Planner 默认只做 Shadow 对比；Shadow 决策绝不调用 Tool 或写能力建议。
ADAPTIVE_PLANNER_MODE=shadow
ADAPTIVE_PLANNER_ROLLOUT_PERCENT=0
ADAPTIVE_PLANNER_SHADOW_SAMPLE_PERCENT=100
ADAPTIVE_PLANNER_SCHEMA_VERSION=planner-decision-v1
LLM_CLASSIFICATION_MODE=rule_only
LLM_CLASSIFICATION_ALLOW_FREE_PATHS=false
# 双摘要默认使用 CPU-only Jieba + LexRank；即使 LLM_ENABLED=true 也不会自动把上传正文发送给模型。
DOCUMENT_SUMMARY_ENABLED=true
DOCUMENT_SUMMARY_PROVIDER=extractive
DOCUMENT_SUMMARY_PROMPT_VERSION=document-summary-v1
DOCUMENT_SUMMARY_SCHEMA_VERSION=document-summary-schema-v1
LLM_CLASSIFICATION_SUMMARY_ENABLED=true
CLASSIFICATION_SUMMARY_PROVIDER=extractive
LLM_CLASSIFICATION_SUMMARY_PROMPT_VERSION=classification-topic-summary-v1
CLASSIFICATION_SUMMARY_SCHEMA_VERSION=classification-topic-summary-schema-v1
# 用户在对话中明确要求总结、讲解时才允许使用 LLM；设为 disabled 可完全关闭该调用。
CHAT_DOCUMENT_SUMMARY_PROVIDER=llm
# 最终回执只读取后端验证后的结果摘要、证据位置和计划概览；不会读取原文全文，
# 也不能修改数字、文件名、相对路径或证据定位。disabled 时保留确定性回执。
AGENT_RECEIPT_SUMMARY_PROVIDER=llm
# 阶段五证据回答：只在用户明确提问/总结时使用；仍需同时配置 LLM_ENABLED 和模型连接。
EVIDENCE_ANSWER_ENABLED=true
EVIDENCE_ANSWER_PROVIDER=llm
EVIDENCE_ANSWER_PROMPT_VERSION=evidence-answer-v1
EVIDENCE_ANSWER_SCHEMA_VERSION=evidence-answer-schema-v1
EVIDENCE_ANSWER_MAX_DOCUMENTS=12
EVIDENCE_ANSWER_MAX_ITEMS=48
EVIDENCE_ANSWER_MAX_INPUT_CHARS=120000
EVIDENCE_ANSWER_MAX_CALLS=3
EVIDENCE_ANSWER_REPAIR_CALLS=1
EVIDENCE_ANSWER_CACHE_ENABLED=true
# 旧兼容开关：控制首次导入后的解析、摘要、分类和命名建议。
INITIAL_WORKING_COPY_ORGANIZATION_ENABLED=true
# 旧阈值只用于兼容逻辑主分类展示，不决定新的自动物理落位。
INITIAL_ORGANIZATION_CONFIDENCE=0.60
# 新上传默认先分类，再把工作副本首次发布到分类目录；原件不变。
AUTO_PRIMARY_CLASSIFICATION_ENABLED=true
AUTO_INITIAL_PLACEMENT_ENABLED=true
AUTO_CLASSIFICATION_SHADOW_MODE=false
AUTO_CLASSIFICATION_POLICY_VERSION=auto-placement-top1-test-v1
# 未发布校准器时使用全分类保守回退门槛；生产真实落位前必须完成离线抽检。
AUTO_CLASSIFICATION_CALIBRATION_VERSION=unpublished
AUTO_CLASSIFICATION_TARGET_PRECISION=0.99
AUTO_CLASSIFICATION_FULL_TAXONOMY_ENABLED=true
AUTO_CLASSIFICATION_GLOBAL_FALLBACK_POLICY=conservative-v1
AUTO_CLASSIFICATION_FALLBACK_THRESHOLD=0.90
AUTO_CLASSIFICATION_FALLBACK_MARGIN=0.20
# 阶段三默认使用 CPU 中文词法索引；不下载 embedding 模型，也不要求 GPU。
RETRIEVAL_MODE=lexical
CHINESE_TOKENIZER=jieba
DOCUMENT_CHUNK_MAX_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=120
# 以下是 worker 资源预算，不是上传业务限制；超出时保留文件并将检索标记为待处理。
DOCUMENT_INDEX_MAX_CHARS=50000000
DOCUMENT_INDEX_MAX_CHUNKS=50000
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=disabled

# 阶段四两阶段文件检索配置。
# 默认启用 PostgreSQL GIN + 候选内精查链路；仅在紧急回退时显式设为 false。
TWO_STAGE_RETRIEVAL_ENABLED=true
RETRIEVAL_DOCUMENT_CANDIDATE_LIMIT=30
RETRIEVAL_DOCUMENT_DETAIL_LIMIT=12
RETRIEVAL_CHUNK_LIMIT_PER_DOCUMENT=3
RETRIEVAL_CHUNK_GLOBAL_LIMIT=24
RETRIEVAL_QUERY_MAX_CHARS=500
RETRIEVAL_PREVIEW_MAX_CHARS=240
RETRIEVAL_STATEMENT_TIMEOUT_MS=2000
# 受限 pg_trgm 补召回参数：仅当查询长度达阈值时启用，避免短查询触发无界扫描。
RETRIEVAL_FILENAME_TRGM_MIN_CHARS=4
RETRIEVAL_FILENAME_TRGM_CANDIDATE_LIMIT=20
RETRIEVAL_FILENAME_TRGM_SIMILARITY_THRESHOLD=0.25

# 图片与扫描件动态结构化抽取。默认关闭；PP-StructureV3 在专用 worker 中延迟加载。
PP_STRUCTURE_ENABLED=false
PP_STRUCTURE_DEVICE=cpu
PP_STRUCTURE_PIPELINE_CONFIG=PP-StructureV3
PP_STRUCTURE_MODEL_SOURCE=BOS
# 通用 OCR 与表格内 OCR 使用 PP-OCRv6 medium；印章等专项模型不受这两项覆盖。
PP_STRUCTURE_TEXT_DETECTION_MODEL=PP-OCRv6_medium_det
PP_STRUCTURE_TEXT_RECOGNITION_MODEL=PP-OCRv6_medium_rec
# 启用页面方向识别和去畸变时 Pipeline 会同时初始化 PP-LCNet_x1_0_doc_ori 与 UVDoc。
PP_STRUCTURE_USE_DOC_PREPROCESSOR=true
# CPU 默认只启用字段抽取所需的版面、区域与通用 OCR；专项重模型按部署能力显式开启。
PP_STRUCTURE_USE_TABLE_RECOGNITION=false
PP_STRUCTURE_USE_FORMULA_RECOGNITION=false
PP_STRUCTURE_USE_CHART_RECOGNITION=false
PP_STRUCTURE_USE_SEAL_RECOGNITION=false
PP_STRUCTURE_USE_REGION_DETECTION=true
PP_STRUCTURE_MAX_IMAGE_PIXELS=24000000
PP_STRUCTURE_MAX_PDF_PAGES=50
STRUCTURED_EXTRACTION_ENABLED=false
# 显式设为 openai_compatible 后启用专用字段映射 LLM；下列空项会复用对应的全局 LLM_* 配置。
STRUCTURED_EXTRACTION_LLM_PROVIDER=disabled
STRUCTURED_EXTRACTION_LLM_BASE_URL=
STRUCTURED_EXTRACTION_LLM_API_KEY=
STRUCTURED_EXTRACTION_LLM_MODEL=
STRUCTURED_EXTRACTION_LLM_TIMEOUT_SECONDS=180
# 单个重型图片结构化任务的总执行上限；超时后 Worker 会终止隔离子进程并写回失败。
STRUCTURED_EXTRACTION_TASK_TIMEOUT_SECONDS=300
STRUCTURED_EXTRACTION_MAX_FIELDS=40
STRUCTURED_EXTRACTION_MAX_RETRY_FIELDS=20
STRUCTURED_EXTRACTION_MAX_RECORDS=1000
STRUCTURED_EXTRACTION_PROMPT_VERSION=structured-extraction-v1
STRUCTURED_EXTRACTION_HIGH_CONFIDENCE=0.85
STRUCTURED_EXTRACTION_RETRY_CONFIDENCE=0.65
STRUCTURED_EXTRACTION_EXTERNAL_IMAGES_AUTHORIZED=false
# 本地 PaddleOCR-VL 只在 Autonomous Loop 判定字段缺失/低置信度时运行一次。
# disabled 不加载 VLM；paddleocr_vl 不需要开启上面的外部图片授权。
STRUCTURED_EXTRACTION_VISION_PROVIDER=disabled
STRUCTURED_EXTRACTION_VISION_CROP_UPSCALE=2.0
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
PADDLEOCR_VL_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
PADDLEOCR_VL_BACKEND=native
PADDLEOCR_VL_DEVICE=cpu
PADDLEOCR_VL_MAX_NEW_TOKENS=4096

DOCLING_ENABLED=true
DOCLING_FORMATS=pdf,docx
# 基础图片/扫描 PDF OCR Provider：paddleocr_cpu 或 tencent_cloud。
OCR_ENABLED=true
OCR_PROVIDER=tencent_cloud
# 腾讯云 OCR 会接收图片内容；只有明确授权为 true 才允许外发。
OCR_EXTERNAL_CONTENT_AUTHORIZED=false
# 腾讯云 API 3.0 凭证，仅填写真实服务器环境变量或密钥管理系统，禁止提交 SecretKey。
TENCENT_CLOUD_OCR_SECRET_ID=
TENCENT_CLOUD_OCR_SECRET_KEY=
TENCENT_CLOUD_OCR_REGION=ap-guangzhou
TENCENT_CLOUD_OCR_ENDPOINT=ocr.tencentcloudapi.com
TENCENT_CLOUD_OCR_ACTION=GeneralAccurateOCR
TENCENT_CLOUD_OCR_TIMEOUT_SECONDS=30
TENCENT_CLOUD_OCR_MAX_RETRIES=2
TENCENT_CLOUD_OCR_MAX_QPS=2
TENCENT_CLOUD_OCR_MAX_IMAGE_BYTES=10485760
OCR_LOCAL_FALLBACK_ENABLED=false
OCR_PADDLE_MODEL_SOURCE=BOS
OCR_LLM_ENABLED=false
OCR_LLM_FALLBACK_QUALITY_THRESHOLD=0.68
# 关闭 Docling 内置 OCR，扫描 PDF 才会由下方基础腾讯云 Provider 按页识别。
DOCLING_OCR_ENABLED=false

# 图片/扫描 PDF 表格结构 Provider：pp_structure_v3 或 tencent_cloud_table。
# 腾讯云表格 Provider 复用上方腾讯云 OCR 凭证和 OCR_EXTERNAL_CONTENT_AUTHORIZED 授权。
STRUCTURED_EXTRACTION_LAYOUT_PROVIDER=pp_structure_v3
TENCENT_CLOUD_TABLE_OCR_MAX_QPS=2

# 旧版 .doc/.xls 在隔离目录转换后发布为版本级持久化 .docx/.xlsx 派生件，后续读取直接复用。
# 当前阶段只做格式、MIME、宏和加密风险检查，不实现、也不宣称已执行病毒扫描。
LEGACY_OFFICE_CONVERSION_ENABLED=true
LEGACY_OFFICE_CONVERTER=libreoffice
# 可留空自动发现；Windows 可填 C:\Program Files\LibreOffice\program\soffice.com，
# macOS 可填 /Applications/LibreOffice.app/Contents/MacOS/soffice，Linux 可填 /usr/bin/soffice。
LIBREOFFICE_EXECUTABLE=
LEGACY_OFFICE_CONVERSION_TIMEOUT_SECONDS=90
LEGACY_OFFICE_MAX_FILE_SIZE_MB=100
LEGACY_OFFICE_DERIVATIVE_DIR=derivatives/office

# Docling 使用预下载的本地模型目录；部署时按实际挂载路径调整。
DOCLING_ARTIFACTS_PATH=/opt/file-agent/models/docling
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# Neo4j 文件知识图谱配置（这里的 GRAPH 不是 LangGraph）：
# PostgreSQL 仍是文件、分类、反馈等业务事实的唯一事实源；Neo4j 只保存可重建的图投影，
# 用于关系候选扩展、相似文件召回和分类重排。Neo4j 不可用时应降级到基础分类链路。
# 启用前需安装 requirements-graph.txt、保证 Neo4j 可连接，并完成首次图投影同步。
# 图谱分类默认启用；缺少连接配置时无损降级，不影响 PostgreSQL 事实链路和词法检索。
GRAPH_CLASSIFICATION_ENABLED=true
# Neo4j Bolt 连接地址、账号、密码和数据库名；复制后必须先填写强密码，否则 compose 会拒绝启动。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# 单次 Neo4j 查询超时时间（秒），超时后应走降级逻辑，不能阻塞基础文件能力。
NEO4J_QUERY_TIMEOUT_SECONDS=3
# 启用 Neo4j 可重建投影；API 启动只创建 GRAPH 队列任务，不同步执行全量投影。
# 第一次由 GRAPH worker 完成 bootstrap，后续正式分类通过 PostgreSQL Outbox 增量投影。
NEO4J_SYNC_ENABLED=true
# 关系候选扩展的最大跳数，当前实现限制为 1～2 跳；跳数越大，候选越多、查询成本越高。
GRAPH_CLASSIFICATION_MAX_HOPS=1
# 图谱分类候选数量上限，当前实现限制为 1～20。
GRAPH_CLASSIFICATION_TOP_K=8
# 图谱分类默认使用 shadow：执行并记录对比但仍返回基础结果；评估通过后才能改为 enabled。
GRAPH_CLASSIFICATION_MODE=shadow
# 默认启用 Neo4j 向量相似文件召回；模型目录缺失时结构化降级，不得伪造向量结果。
GRAPH_EMBEDDING_ENABLED=true
# 向量模型提供方。当前只支持 local，表示只读取本地模型，不把文件正文发送到外部服务。
GRAPH_EMBEDDING_PROVIDER=local
# sentence-transformers 本地模型目录；启用图向量能力时必须填写存在且可读的目录。
GRAPH_EMBEDDING_MODEL_PATH=
# 模型的稳定名称，仅用于配置标识和审计；实际模型仍从 GRAPH_EMBEDDING_MODEL_PATH 加载。
GRAPH_EMBEDDING_MODEL_NAME=
# 向量生成规则版本。更换模型、切分方式或语义规则后应递增，避免复用旧向量。
GRAPH_EMBEDDING_VERSION=document-semantic-v1
# 向量维度，必须与本地模型输出及 Neo4j 向量索引维度一致。
GRAPH_EMBEDDING_DIMENSION=384
# Neo4j 中用于文件版本向量检索的索引名称。
GRAPH_VECTOR_INDEX_NAME=document_version_embedding_v1
# 每次语义召回的相似文件候选上限，当前实现限制为 1～50。
GRAPH_VECTOR_TOP_K=12
# 语义召回最低相似度，范围为 0～1；0.0 表示当前不按分数过滤。
GRAPH_VECTOR_MIN_SCORE=0.0
# 是否让文件 Worker 消费 PostgreSQL 分类 Outbox 并投影正式 CONFIRMED_AS 关系；
# 必须同时开启 NEO4J_SYNC_ENABLED；默认开启，仍需按 runbook 独立启动 worker 进程。
GRAPH_PROJECTION_WORKER_ENABLED=true
# 图投影同步与向量生成命令的单批处理数量，当前实现限制为 1～5000。
GRAPH_PROJECTION_BATCH_SIZE=500
# 是否允许收集用户对分类建议的接受、拒绝和修正反馈；它不会自动开启图谱分类。
GRAPH_FEEDBACK_COLLECTION_ENABLED=true
# enabled 模式下按用户稳定分桶启用图谱增强的比例；未命中的用户仍按 shadow 模式运行。
GRAPH_CLASSIFICATION_ROLLOUT_PERCENT=10
# 图谱分类评估达到“样本充足”所需的最少反馈数，不影响反馈的正常收集。
GRAPH_FEEDBACK_EVAL_MIN_SAMPLES=100
MANAGED_PATH_CLASSIFICATION_PROFILE_DIR=./rules/managed-root-classification
MANAGED_PATH_DEFAULT_MODE=NONE
MANAGED_PATH_VECTOR_PILOT_LIMIT=1000
MANAGED_FILE_CLASSIFICATION_SYNC_LIMIT=20
MANAGED_FILE_CLASSIFICATION_BATCH_SIZE=20

# 重命名解析模式：hybrid=Docling 与原生解析字段级仲裁（默认生产模式）；
# native=只使用原生解析器（质量异常时紧急回退）；docling=只使用 Docling（对比测试和问题定位）。
FILE_RENAME_PARSE_MODE=hybrid
# 文件重命名默认继续使用 Native 执行器；只有离线部署并校验固定 F2 二进制后才切换为 f2。
FILE_RENAME_EXECUTOR=native
FILE_RENAME_MAX_BATCH_SIZE=20
FILE_RENAME_EXECUTION_TIMEOUT_SECONDS=60
# 重命名差异质量校验：默认关闭模型调用，risk_based 仅校验中高风险建议。
FILE_RENAME_LLM_VALIDATION_ENABLED=false
FILE_RENAME_LLM_VALIDATION_MODE=risk_based
FILE_RENAME_LLM_VALIDATION_THRESHOLD=0.60
FILE_RENAME_LLM_VALIDATION_TIMEOUT_SECONDS=30
FILE_RENAME_LLM_VALIDATION_MAX_ITEMS_PER_BATCH=20
FILE_RENAME_LLM_VALIDATION_PROMPT_VERSION=rename-validation-v1
F2_BINARY_PATH=f2
F2_EXPECTED_VERSION=2.2.2
F2_FALLBACK_TO_NATIVE=false
F2_STDOUT_MAX_BYTES=1048576
