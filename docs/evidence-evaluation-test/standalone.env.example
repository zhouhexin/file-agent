# 独立测试配置，复制到 runtime/evidence-test/.env；不加载或覆盖项目根 .env。
# 真正的本机版本已生成，含现有连接信息，请勿提交。
DATABASE_URL=postgresql+psycopg2://fileagent_user:CHANGE_ME@DB_HOST:5432/file_agent_evidence_test
AUTO_CREATE_TABLES=false
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_TEST_SECRET

# 所有文件和日志隔离在 runtime/evidence-test 内。
FILE_STORAGE_ROOT=./uploads
MANAGED_ROOT_ARCHIVE_WRITE_PATH=./originals
WORKING_COPY_STORAGE_ROOT=./working-copies
TRASH_STORAGE_ROOT=./trash
LOG_DIR=./logs

# 真实文件问答及证据评估。
LLM_ENABLED=true
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://YOUR_LLM_ENDPOINT/v1
LLM_CHAT_MODEL=CHANGE_ME
# 仅用于C阶段Harness；默认保留原API，也可以改为codex-login复用本机登录。
EVIDENCE_HARNESS_PROVIDER=openai-compatible
EVIDENCE_HARNESS_CODEX_MODEL=gpt-6.1-sol
# 仅Codex使用；https禁用WebSocket，auto保留CLI自动选择。
EVIDENCE_HARNESS_CODEX_TRANSPORT=https
# 跨模型验证时需显式设为true；不影响是否live，真实调用仍需命令加--live。
EVIDENCE_HARNESS_ALLOW_MODEL_PROFILE_CHANGE=false
EVIDENCE_EVALUATION_MODE=shadow
EVIDENCE_EVALUATION_TIMEOUT_SECONDS=60
EVIDENCE_ANSWER_CACHE_ENABLED=false
RETRIEVAL_MODE=lexical

# 不启动额外的规划、图谱或扫描任务；其余使用代码默认值。
ADAPTIVE_PLANNER_MODE=legacy
GRAPH_CLASSIFICATION_ENABLED=false
GRAPH_EMBEDDING_ENABLED=false
NEO4J_SYNC_ENABLED=false
GRAPH_PROJECTION_WORKER_ENABLED=false
MANAGED_ROOT_RECONCILE_ON_STARTUP=false

# 文本PDF/Word等使用既有解析器；扫描件使用本地OCR，需已有Paddle模型可用。
DOCLING_ENABLED=false
OCR_PROVIDER=paddleocr_cpu
