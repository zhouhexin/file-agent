# 用户真实上传文件的证据评估测试覆盖配置；不包含密码，不替换项目根 .env。
# 完整流程见同目录 real-files.md；本文件不导入任何合成样本。
# 在仓库根目录的新终端中：set -a; source docs/evidence-evaluation-test/evaluation-test.env.example; set +a
# 数据库地址、LLM_API_KEY、LLM_BASE_URL、LLM_CHAT_MODEL继续从现有根 .env 读取。

# 用户自行开始真实模型测试后会产生模型调用费用。
LLM_ENABLED=true
EVIDENCE_ANSWER_ENABLED=true
EVIDENCE_ANSWER_PROVIDER=llm
EVIDENCE_EVALUATION_MODE=shadow
EVIDENCE_EVALUATION_TIMEOUT_SECONDS=20
EVIDENCE_EVALUATION_MAX_INPUT_CHARS=48000
EVIDENCE_EVALUATION_MAX_CALLS=3
EVIDENCE_EVALUATION_MAX_OUTPUT_TOKENS=3000
# 每次建立新证据包都检查，便于对比日志；测试结束重新启动时恢复原配置。
EVIDENCE_ANSWER_CACHE_ENABLED=false

# 本测试走已有的CPU全文检索，不启用向量模型或图谱服务。
RETRIEVAL_MODE=lexical
CHINESE_TOKENIZER=jieba
TWO_STAGE_RETRIEVAL_ENABLED=true
# 导入阶段的摘要继续用本地抽取式方法；真实问答和评估才使用已配置LLM。
DOCUMENT_SUMMARY_PROVIDER=extractive
CLASSIFICATION_SUMMARY_PROVIDER=extractive
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=disabled
GRAPH_EMBEDDING_ENABLED=false
GRAPH_CLASSIFICATION_ENABLED=false
GRAPH_CLASSIFICATION_MODE=off
NEO4J_SYNC_ENABLED=false
GRAPH_PROJECTION_WORKER_ENABLED=false
