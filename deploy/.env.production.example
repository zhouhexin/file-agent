# Windows 11（6 核/32GB）全功能 CPU 生产部署模板。
# deploy.ps1 会替换双下划线占位值；真实 deploy/.env 不得提交到 Git。

CADDY_SITE_ADDRESS=__CADDY_SITE_ADDRESS__
UPLOAD_MAX_SIZE=1024MB
FILE_AGENT_IMAGE_TAG=20260826

POSTGRES_DB=fileAgent
POSTGRES_USER=fileagent_user
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
NEO4J_PASSWORD=__NEO4J_PASSWORD__

JWT_SECRET_KEY=__JWT_SECRET_KEY__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 国内联网构建。HF_ENDPOINT 可改为经过管理员验证的镜像站；运行期模型使用本地缓存。
MODEL_PRELOAD=true
REQUIRE_PRELOADED_MODELS=true
APT_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HF_ENDPOINT=https://hf-mirror.com
DOCLING_MODEL_GIT_BASE=https://hf-mirror.com
# 可选：由 prepare-local-model-cache.ps1 生成的标准缓存目录；默认使用空目录。
LOCAL_MODEL_CACHE_CONTEXT=./empty-model-cache
GRAPH_EMBEDDING_BUILD_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_PDX_CPU_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# 外部 OpenAI-compatible LLM。部署前填写真实地址、密钥和模型。
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_CLASSIFICATION_MODE=llm_validate
LLM_CLASSIFICATION_ALLOW_FREE_PATHS=false
CHAT_DOCUMENT_SUMMARY_PROVIDER=llm
AGENT_RECEIPT_SUMMARY_PROVIDER=llm
EVIDENCE_ANSWER_ENABLED=true
EVIDENCE_ANSWER_PROVIDER=llm
EVIDENCE_ANSWER_MAX_DOCUMENTS=12
EVIDENCE_ANSWER_MAX_ITEMS=48
EVIDENCE_ANSWER_MAX_INPUT_CHARS=120000
EVIDENCE_ANSWER_MAX_CALLS=3
EVIDENCE_ANSWER_REPAIR_CALLS=1
EVIDENCE_ANSWER_CACHE_ENABLED=true

# 图片普通 OCR 走本地 PaddleOCR；不默认把原始图片发送给外部 LLM。
OCR_ENABLED=true
OCR_PADDLE_MODEL_SOURCE=BOS
OCR_LLM_ENABLED=false
OCR_LLM_FALLBACK_QUALITY_THRESHOLD=0.68

# 启用 PP-StructureV3 全部图片结构化抽取子能力。
PP_STRUCTURE_ENABLED=true
PP_STRUCTURE_DEVICE=cpu
PP_STRUCTURE_PIPELINE_CONFIG=PP-StructureV3
PP_STRUCTURE_MODEL_SOURCE=BOS
PP_STRUCTURE_TEXT_DETECTION_MODEL=PP-OCRv6_medium_det
PP_STRUCTURE_TEXT_RECOGNITION_MODEL=PP-OCRv6_medium_rec
PP_STRUCTURE_USE_DOC_PREPROCESSOR=true
PP_STRUCTURE_USE_TABLE_RECOGNITION=true
PP_STRUCTURE_USE_FORMULA_RECOGNITION=true
PP_STRUCTURE_USE_CHART_RECOGNITION=true
PP_STRUCTURE_USE_SEAL_RECOGNITION=true
PP_STRUCTURE_USE_REGION_DETECTION=true
PP_STRUCTURE_MAX_IMAGE_PIXELS=24000000
PP_STRUCTURE_MAX_PDF_PAGES=50

STRUCTURED_EXTRACTION_ENABLED=true
STRUCTURED_EXTRACTION_LLM_PROVIDER=openai_compatible
STRUCTURED_EXTRACTION_LLM_BASE_URL=
STRUCTURED_EXTRACTION_LLM_API_KEY=
STRUCTURED_EXTRACTION_LLM_MODEL=
STRUCTURED_EXTRACTION_LLM_TIMEOUT_SECONDS=180
STRUCTURED_EXTRACTION_MAX_FIELDS=40
STRUCTURED_EXTRACTION_MAX_RETRY_FIELDS=20
STRUCTURED_EXTRACTION_MAX_RECORDS=1000
STRUCTURED_EXTRACTION_EXTERNAL_IMAGES_AUTHORIZED=false
STRUCTURED_EXTRACTION_VISION_PROVIDER=paddleocr_vl
STRUCTURED_EXTRACTION_VISION_CROP_UPSCALE=2.0
STRUCTURED_EXTRACTION_WORKER_CONCURRENCY=1
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
PADDLEOCR_VL_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
PADDLEOCR_VL_BACKEND=native
PADDLEOCR_VL_DEVICE=cpu
PADDLEOCR_VL_MAX_NEW_TOKENS=4096

DOCLING_ENABLED=true
DOCLING_FORMATS=pdf,docx
DOCLING_OCR_ENABLED=true
DOCLING_ARTIFACTS_PATH=/opt/file-agent/models/docling
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# 旧版 DOC/XLS 统一持久化派生件。
LEGACY_OFFICE_CONVERSION_ENABLED=true
LEGACY_OFFICE_CONVERTER=libreoffice
LIBREOFFICE_EXECUTABLE=
LEGACY_OFFICE_CONVERSION_TIMEOUT_SECONDS=180
LEGACY_OFFICE_MAX_FILE_SIZE_MB=100
LEGACY_OFFICE_DERIVATIVE_DIR=derivatives/office
MANAGED_SOURCE_LIBREOFFICE_CONCURRENCY=1

# PostgreSQL 是业务事实源；Neo4j 保存可重建图投影。
GRAPH_CLASSIFICATION_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=5
NEO4J_SYNC_ENABLED=true
GRAPH_CLASSIFICATION_MAX_HOPS=1
GRAPH_CLASSIFICATION_TOP_K=8
GRAPH_CLASSIFICATION_MODE=shadow
GRAPH_EMBEDDING_ENABLED=true
GRAPH_EMBEDDING_PROVIDER=local
GRAPH_EMBEDDING_MODEL_PATH=/opt/file-agent/models/document-embedding
GRAPH_EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
GRAPH_EMBEDDING_VERSION=document-semantic-v1
GRAPH_EMBEDDING_DIMENSION=384
GRAPH_VECTOR_INDEX_NAME=document_version_embedding_v1
GRAPH_VECTOR_TOP_K=12
GRAPH_VECTOR_MIN_SCORE=0.0
GRAPH_PROJECTION_WORKER_ENABLED=true
GRAPH_PROJECTION_BATCH_SIZE=100
GRAPH_FEEDBACK_COLLECTION_ENABLED=true
GRAPH_CLASSIFICATION_ROLLOUT_PERCENT=10
GRAPH_FEEDBACK_EVAL_MIN_SAMPLES=100

# 受管目录：Windows 宿主机路径只用于 Compose 挂载，应用只识别容器路径。
MANAGED_ROOT_HOST_PATH=E:/workdata
MANAGED_ROOT_WORKDATA=/managed/workdata
MANAGED_ROOT_WORKDATA_DISPLAY_NAME=工作资料库
MANAGED_ROOT_WORKDATA_CLASSIFICATION_MODE=NONE
MANAGED_ROOT_WORKDATA_ALLOW_RENAME=false
MANAGED_ROOT_VOLUME_MODE=ro
MANAGED_ROOT_ARCHIVE_WRITE_PATH=/data/uploads/managed-original/upload-archive
MANAGED_ROOT_ARCHIVE_ENABLED=true
MANAGED_ROOT_WATCH_ENABLED=true
MANAGED_ROOT_WATCH_POLL_SECONDS=3
FILESYSTEM_WATCHER_POLL_SECONDS=3
MANAGED_ROOT_RECONCILE_INTERVAL_SECONDS=300
MANAGED_ROOT_RECONCILE_ON_STARTUP=true
MANAGED_ROOT_SCAN_BATCH_SIZE=50
MANAGED_ROOT_SCAN_BATCH_MAX_SECONDS=5

# 全量工作副本同步：先源侧分析/索引，再以低优先级完整物化。
FILESYSTEM_ASYNC_JOBS_ENABLED=true
FILESYSTEM_JOB_LEASE_SECONDS=300
FILESYSTEM_WORKER_POLL_SECONDS=3
MANAGED_FILE_INITIALIZATION_MODE=source_index_first
MANAGED_SOURCE_ANALYSIS_ENABLED=true
MANAGED_SOURCE_ANALYSIS_BACKGROUND_PRIORITY=100
MANAGED_SOURCE_ANALYSIS_ON_DEMAND_PRIORITY=10
MANAGED_SOURCE_ANALYSIS_BATCH_SIZE=10
MANAGED_SOURCE_SEARCH_ENABLED=true
MATERIALIZE_ALL_MANAGED_FILES=true
MATERIALIZE_WORKING_COPY_BACKGROUND_PRIORITY=100
MATERIALIZE_RELEVANT_FILES_AFTER_RESPONSE=true
MATERIALIZE_WORKING_COPY_PRIORITY=20
MATERIALIZE_RELEVANT_FILES_BATCH_SIZE=20
WORKING_COPY_STORAGE_ROOT=/data/uploads/working-copies
TRASH_STORAGE_ROOT=/data/uploads/trash
TRASH_RETENTION_DAYS=30
TRASH_AUTO_PURGE_ENABLED=false

UPLOAD_MAX_FILE_SIZE_MB=1024
UPLOAD_CHUNK_SIZE_BYTES=1048576
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,xlsm,txt,md,csv,png,jpg,jpeg,tif,tiff,bmp,webp
UPLOAD_ARCHIVE_ENABLED=true
UPLOAD_ARCHIVE_RETRY_INTERVAL_SECONDS=300
UPLOAD_DUPLICATE_CHECK_ENABLED=true
UPLOAD_DUPLICATE_SIMILARITY_THRESHOLD=0.90
UPLOAD_DUPLICATE_MAX_CANDIDATES=5
UPLOAD_DUPLICATE_CONFIRMATION_TTL_HOURS=168
ARCHIVE_WORKER_CONCURRENCY=1
IMPORT_WORKER_CONCURRENCY=1
WORKING_COPY_IMPORT_BATCH_SIZE=20
WORKING_COPY_OPERATION_BATCH_SIZE=20

# CPU 词法检索保持主链路；图向量只做增强。
RETRIEVAL_MODE=lexical
CHINESE_TOKENIZER=jieba
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=disabled
TWO_STAGE_RETRIEVAL_ENABLED=true
RETRIEVAL_DOCUMENT_CANDIDATE_LIMIT=30
RETRIEVAL_DOCUMENT_DETAIL_LIMIT=12
RETRIEVAL_CHUNK_LIMIT_PER_DOCUMENT=3
RETRIEVAL_CHUNK_GLOBAL_LIMIT=24
RETRIEVAL_STATEMENT_TIMEOUT_MS=3000

DOCUMENT_SUMMARY_ENABLED=true
DOCUMENT_SUMMARY_PROVIDER=extractive
LLM_CLASSIFICATION_SUMMARY_ENABLED=true
CLASSIFICATION_SUMMARY_PROVIDER=extractive
INITIAL_WORKING_COPY_ORGANIZATION_ENABLED=true
INITIAL_ORGANIZATION_CONFIDENCE=0.60
FILE_RENAME_PARSE_MODE=hybrid
FILE_RENAME_EXECUTOR=native
FILE_RENAME_MAX_BATCH_SIZE=20
FILE_RENAME_EXECUTION_TIMEOUT_SECONDS=60
FILE_RENAME_LLM_VALIDATION_ENABLED=true
FILE_RENAME_LLM_VALIDATION_MODE=risk_based
FILE_RENAME_LLM_VALIDATION_TIMEOUT_SECONDS=180

MCP_FILESYSTEM_ENABLED=false
MCP_FILESYSTEM_ROOT=/managed/workdata
MCP_FILESYSTEM_COMMAND=/usr/local/bin/mcp-server-filesystem
MCP_FILESYSTEM_TIMEOUT_SECONDS=45
MCP_FILESYSTEM_MAX_OUTPUT_CHARS=50000

LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
