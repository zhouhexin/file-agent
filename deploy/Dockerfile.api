# 日常代码镜像只覆盖业务代码；系统包、Python 依赖和模型全部复用固定基础镜像。

ARG API_RUNTIME_BASE_IMAGE=file-agent-api-runtime-base:20260904-v1
FROM ${API_RUNTIME_BASE_IMAGE}

WORKDIR /app

# --link 让代码保持为独立层，BuildKit 无需重新导出 28GB 父镜像内容。
COPY --link . /app

# Windows 工作区不保留执行位，因此用第二个独立链接层只修正入口脚本权限。
COPY --link deploy/entrypoint.api.sh /app/deploy/entrypoint.api.sh
# Windows 工作区即使误生成 CRLF，镜像中的 Linux 入口脚本也必须规范为 LF。
RUN sed -i 's/\r$//' /app/deploy/entrypoint.api.sh \
    && chmod 755 /app/deploy/entrypoint.api.sh

EXPOSE 8000

ENTRYPOINT ["/app/deploy/entrypoint.api.sh"]
